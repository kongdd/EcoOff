{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EcoOff",
  "version": "0.2.0",
  "identifier": "io.github.kongdd.ecooff",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EcoOff",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["images/icon.ico"]
  }
}
